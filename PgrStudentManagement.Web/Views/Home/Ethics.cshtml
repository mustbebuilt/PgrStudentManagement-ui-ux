@{
    ViewData["Title"] = "Research Ethics & Integrity";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <span class="portal-module-tag tag-mock">Preview Module</span>
        <h1 class="mb-0">Research Ethics &amp; Governance</h1>
    </div>
    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">
        Return to Dashboard
    </a>
</div>

<div class="alert alert-info" role="status">
    <strong>Module Preview:</strong> Online Research Ethics Committee (REC) sign-off and Data Management Plan (DMP) uploads are stubbed for this demonstration environment.
</div>

<section class="portal-grid" aria-label="Ethics and governance services">
    <article class="portal-module-card">
        <div>
            <span class="portal-module-tag">Ethics Triage</span>
            <h2 class="h4">Ethics Self-Assessment &amp; REC Review</h2>
            <p class="text-muted">
                Determine whether a doctoral project requires proportionate review or full Research Ethics Committee panel scrutiny before data collection begins.
            </p>
        </div>
        <div class="portal-module-actions">
            <button type="button" class="btn btn-outline-primary btn-sm" disabled>
                Start Ethics Checklist (Coming Soon)
            </button>
        </div>
    </article>

    <article class="portal-module-card">
        <div>
            <span class="portal-module-tag">Open Research</span>
            <h2 class="h4">Data Management Plans (DMP)</h2>
            <p class="text-muted">
                Document storage security, anonymisation protocols, UK GDPR legal basis, and open-access repository archiving schedules.
            </p>
        </div>
        <div class="portal-module-actions">
            <button type="button" class="btn btn-outline-primary btn-sm" disabled>
                Upload DMP Template (Coming Soon)
            </button>
        </div>
    </article>

    <article class="portal-module-card">
        <div>
            <span class="portal-module-tag">Health &amp; Safety</span>
            <h2 class="h4">Fieldwork &amp; Laboratory Risk</h2>
            <p class="text-muted">
                Record off-campus travel authorisations, lone-working protocols, and laboratory hazard assessments.
            </p>
        </div>
        <div class="portal-module-actions">
            <button type="button" class="btn btn-outline-primary btn-sm" disabled>
                Log Risk Assessment (Coming Soon)
            </button>
        </div>
    </article>
</section>

