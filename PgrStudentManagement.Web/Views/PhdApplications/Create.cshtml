@model PgrStudentManagement.Web.Modules.PhdApplications.Models.PhdApplication

@*
    ===========================================================================
    UI/UX & ACCESSIBILITY LAB — STARTING POINT (Create.cshtml)
    ===========================================================================
    Right now, every field is a plain <input type="text"> preceded by a <span>
    (instead of a semantic <label>), with no hints, no fieldsets, and no
    validation messages.

    Follow LabResources/lab1-instructions.md and copy/adapt the ready-made
    snippets from LabResources/code-snippets.md:
      - Part 1 (Quick Wins):
          * Task 1: Fix the low-contrast .btn-primary colour in wwwroot/css/site.css (Snippet 1.A)
          * Task 2: Replace every <span class="form-label"> with <label asp-for="..." class="form-label"></label> (Snippet 1.B)
      - Part 2: Change @model to CreatePhdApplicationViewModel & remove system fields (Snippet 2.A & 2.B)
      - Part 3: Replace plain text boxes with proper semantic controls (Snippets 3.A–3.D)
      - Part 4: Improve form layout, section grouping (.form-section, .form-grid-2),
                and proportionate input widths (.input-width-sm, .input-width-md) (Snippets 4.A & 4.B)
      - Part 5: Add human-readable display names, hints (aria-describedby),
                and live character counter (Snippets 5.A & 5.B)
      - Part 7: Add accessible error summary + inline errors (Snippets 7.A & 7.B)
      - Part 8: Add HTML client-side validation attributes (Snippet 8.A)
    ===========================================================================
*@

@{
    // TODO (Lab Part 7): Prefix title with "Error: " when !ViewData.ModelState.IsValid (see Snippet 7.A)
    ViewData["Title"] = "Create PhD Application";
}

<h1>Create PhD Application</h1>

@* TODO (Lab Part 4): Wrap the form in <div class="form-container"> and group related fields into
   four <section class="form-section"> cards (see Snippet 4.B in code-snippets.md). *@
@* TODO (Lab Part 7): Add the accessible error summary box here (see Snippet 7.A in code-snippets.md) *@

<form asp-action="Create" method="post">

    @* TODO (Lab Part 1 - Task 2): Replace <span class="form-label"> with <label asp-for="..." class="form-label"></label> (Snippet 1.B).
       TODO (Lab Part 2): Remove ApplicationReference from the form — generate it on the server instead! *@
    <div class="mb-3">
        <span class="form-label">ApplicationReference</span>
        <input type="text"
               id="ApplicationReference"
               name="ApplicationReference"
               value="@Model.ApplicationReference"
               class="form-control" />
    </div>

    @* TODO (Lab Part 1 - Task 2): Replace each <span class="form-label"> with <label asp-for="..." class="form-label"></label> (Snippet 1.B).
       TODO (Lab Part 3 & Part 4): Replace EmailAddress with type="email" (Snippet 3.A), wrap Section 1 in
       <section class="form-section">, and pair FirstName/LastName side-by-side in <div class="form-grid-2"> (Snippet 4.B). *@
    <div class="mb-3">
        <span class="form-label">FirstName</span>
        <input type="text"
               id="FirstName"
               name="FirstName"
               value="@Model.FirstName"
               class="form-control" />
    </div>

    <div class="mb-3">
        <span class="form-label">LastName</span>
        <input type="text"
               id="LastName"
               name="LastName"
               value="@Model.LastName"
               class="form-control" />
    </div>

    <div class="mb-3">
        <span class="form-label">EmailAddress</span>
        <input type="text"
               id="EmailAddress"
               name="EmailAddress"
               value="@Model.EmailAddress"
               class="form-control" />
    </div>

    @* TODO (Lab Part 1 - Task 2): Replace <span class="form-label"> with <label asp-for="ProgrammeCode" class="form-label"></label>.
       TODO (Lab Part 3 & Part 4): Replace ProgrammeCode text input with a <select> dropdown (Snippet 3.B) and size it with .input-width-md (Snippet 4.B) *@
    <div class="mb-3">
        <span class="form-label">ProgrammeCode</span>
        <input type="text"
               id="ProgrammeCode"
               name="ProgrammeCode"
               value="@Model.ProgrammeCode"
               class="form-control" />
    </div>

    @* TODO (Lab Part 3): Replace ModeOfStudy text input with radio buttons ("Full-time", "Part-time")
       wrapped in a <fieldset> and <legend> (see Snippet 3.B in code-snippets.md). *@
    <div class="mb-3">
        <span class="form-label">ModeOfStudy</span>
        <input type="text"
               id="ModeOfStudy"
               name="ModeOfStudy"
               value="@Model.ModeOfStudy"
               class="form-control" />
    </div>

    @* TODO (Lab Part 1 - Task 2): Replace <span class="form-label"> with <label asp-for="ProposedStartDate" class="form-label"></label>.
       TODO (Lab Part 3 & Part 4): Replace ProposedStartDate with <input type="date"> (Snippet 3.B) and size it with .input-width-sm (Snippet 4.B) *@
    <div class="mb-3">
        <span class="form-label">ProposedStartDate</span>
        <input type="text"
               id="ProposedStartDate"
               name="ProposedStartDate"
               value="@Model.ProposedStartDate.ToString("yyyy-MM-dd")"
               class="form-control" />
    </div>

    @* TODO (Lab Part 1 - Task 2): Replace <span class="form-label"> with <label asp-for="ProposedThesisTitle" class="form-label"></label>. *@
    <div class="mb-3">
        <span class="form-label">ProposedThesisTitle</span>
        <input type="text"
               id="ProposedThesisTitle"
               name="ProposedThesisTitle"
               value="@Model.ProposedThesisTitle"
               class="form-control" />
    </div>

    @* TODO (Lab Part 1 - Task 2): Replace <span class="form-label"> with <label asp-for="ResearchSummary" class="form-label"></label>.
       TODO (Lab Part 5): Replace ResearchSummary with a <textarea rows="6">, a hint linked via
       aria-describedby, and a live character counter (see Snippet 5.A & 5.B in code-snippets.md). *@
    <div class="mb-3">
        <span class="form-label">ResearchSummary</span>
        <input type="text"
               id="ResearchSummary"
               name="ResearchSummary"
               value="@Model.ResearchSummary"
               class="form-control" />
    </div>

    @* TODO (Lab Part 3): Replace FundingSource text input with radio buttons inside a <fieldset>
       using Html.GetEnumSelectList<FundingType>() (see Snippet 3.C in code-snippets.md). *@
    <div class="mb-3">
        <span class="form-label">FundingSource</span>
        <input type="text"
               id="FundingSource"
               name="FundingSource"
               value="@Model.FundingSource"
               class="form-control" />
    </div>

    @* TODO (Lab Part 1 - Task 2): Replace <span class="form-label"> with <label asp-for="ProposedSupervisorStaffNumber" class="form-label"></label>.
       TODO (Lab Part 3, Part 4 & Part 5): Replace ProposedSupervisorStaffNumber text box with a <select> showing
       supervisor names from ViewBag.Supervisors, size with .input-width-md, and mark the label "(optional)" (see Snippet 3.D & 4.B). *@
    <div class="mb-3">
        <span class="form-label">ProposedSupervisorStaffNumber</span>
        <input type="text"
               id="ProposedSupervisorStaffNumber"
               name="ProposedSupervisorStaffNumber"
               value="@Model.ProposedSupervisorStaffNumber"
               class="form-control" />
    </div>

    @* TODO (Lab Part 2): Remove SubmittedDate from the form — set it automatically on the server! *@
    <div class="mb-3">
        <span class="form-label">SubmittedDate</span>
        <input type="text"
               id="SubmittedDate"
               name="SubmittedDate"
               value="@Model.SubmittedDate.ToString("yyyy-MM-dd")"
               class="form-control" />
    </div>

    @* TODO (Lab Part 1 - Task 1): Fix the non-WCAG-compliant colour contrast on .btn-primary in wwwroot/css/site.css (Snippet 1.A).
       TODO (Lab Part 4): Wrap the action buttons in <div class="form-actions"> (Snippet 4.B). *@
    <button type="submit"
            class="btn btn-primary">
        Create
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>
</form>

@* TODO (Lab Part 8): Add native HTML validation attributes (required, maxlength, type="email", type="date") to form controls (see Snippet 8.A) *@
