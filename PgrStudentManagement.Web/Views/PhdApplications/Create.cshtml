@model PgrStudentManagement.Web.Modules.PhdApplications.Models.PhdApplication

@*
    ===========================================================================
    UI/UX & ACCESSIBILITY LAB — STARTING POINT (Create.cshtml)
    ===========================================================================
    Right now, every field is a plain <input type="text"> with no hints,
    no fieldsets, and no validation messages.

    Follow LabResources/lab-instructions.md and copy/adapt the ready-made
    snippets from LabResources/code-snippets.md:
      - Part 1: Change @model to CreatePhdApplicationViewModel (Snippet 1.A)
      - Part 2: Replace plain text boxes with proper controls (Snippet 2.A)
      - Part 3: Add human-readable labels, hints (aria-describedby),
                <fieldset>/<legend>, and character counter (Snippet 3.A & 3.B)
      - Part 5: Add accessible error summary + inline errors (Snippet 5.A)
      - Part 6: Add HTML client-side validation attributes (Snippet 6.A)
      - Part 7: Split into sections & add "Save as draft" button (Snippet 7.A)
    ===========================================================================
*@

@{
    // TODO (Lab Part 5): Prefix title with "Error: " when !ViewData.ModelState.IsValid
    ViewData["Title"] = "Create PhD Application";
}

<h1>Create PhD Application</h1>

@* TODO (Lab Part 5): Add the accessible error summary box here (see Snippet 5.A in code-snippets.md) *@

<form asp-action="Create" method="post">

    @* TODO (Lab Part 1 & Part 2): Remove ApplicationReference from the form — generate it on the server instead! *@
    <div class="mb-3">
        <label asp-for="ApplicationReference"
               class="form-label"></label>
        <input type="text"
               id="ApplicationReference"
               name="ApplicationReference"
               value="@Model.ApplicationReference"
               class="form-control" />
    </div>

    @* TODO (Lab Part 2 & Part 3): Group FirstName, LastName, and EmailAddress under an <h2>About you</h2> heading.
       Add autocomplete="given-name" / "family-name" and change EmailAddress to type="email" (see Snippet 2.A). *@
    <div class="mb-3">
        <label asp-for="FirstName"
               class="form-label"></label>
        <input type="text"
               id="FirstName"
               name="FirstName"
               value="@Model.FirstName"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="LastName"
               class="form-label"></label>
        <input type="text"
               id="LastName"
               name="LastName"
               value="@Model.LastName"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="EmailAddress"
               class="form-label"></label>
        <input type="text"
               id="EmailAddress"
               name="EmailAddress"
               value="@Model.EmailAddress"
               class="form-control" />
    </div>

    @* TODO (Lab Part 2): Replace ProgrammeCode text input with a <select> dropdown of programmes (PHD-COMP, PHD-DESIGN, etc.) *@
    <div class="mb-3">
        <label asp-for="ProgrammeCode"
               class="form-label"></label>
        <input type="text"
               id="ProgrammeCode"
               name="ProgrammeCode"
               value="@Model.ProgrammeCode"
               class="form-control" />
    </div>

    @* TODO (Lab Part 2 & Part 3): Replace ModeOfStudy text input with radio buttons ("Full-time", "Part-time")
       wrapped in a <fieldset> and <legend> (see Snippet 2.B in code-snippets.md). *@
    <div class="mb-3">
        <label asp-for="ModeOfStudy"
               class="form-label"></label>
        <input type="text"
               id="ModeOfStudy"
               name="ModeOfStudy"
               value="@Model.ModeOfStudy"
               class="form-control" />
    </div>

    @* TODO (Lab Part 2): Replace ProposedStartDate with <input type="date"> or an intake <select> *@
    <div class="mb-3">
        <label asp-for="ProposedStartDate"
               class="form-label"></label>
        <input type="text"
               id="ProposedStartDate"
               name="ProposedStartDate"
               value="@Model.ProposedStartDate.ToString("yyyy-MM-dd")"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="ProposedThesisTitle"
               class="form-label"></label>
        <input type="text"
               id="ProposedThesisTitle"
               name="ProposedThesisTitle"
               value="@Model.ProposedThesisTitle"
               class="form-control" />
    </div>

    @* TODO (Lab Part 2 & Part 3): Replace ResearchSummary with a <textarea rows="6">, a hint linked via
       aria-describedby, and a live character counter (see Snippet 3.A & 3.B in code-snippets.md). *@
    <div class="mb-3">
        <label asp-for="ResearchSummary"
               class="form-label"></label>
        <input type="text"
               id="ResearchSummary"
               name="ResearchSummary"
               value="@Model.ResearchSummary"
               class="form-control" />
    </div>

    @* TODO (Lab Part 2): Replace FundingSource text input with radio buttons inside a <fieldset>
       using Html.GetEnumSelectList<FundingType>() (see Snippet 2.C in code-snippets.md). *@
    <div class="mb-3">
        <label asp-for="FundingSource"
               class="form-label"></label>
        <input type="text"
               id="FundingSource"
               name="FundingSource"
               value="@Model.FundingSource"
               class="form-control" />
    </div>

    @* TODO (Lab Part 2 & Part 3): Replace ProposedSupervisorStaffNumber text box with a <select> showing
       supervisor names from ViewBag.Supervisors, and mark the label "(optional)" (see Snippet 2.D). *@
    <div class="mb-3">
        <label asp-for="ProposedSupervisorStaffNumber"
               class="form-label"></label>
        <input type="text"
               id="ProposedSupervisorStaffNumber"
               name="ProposedSupervisorStaffNumber"
               value="@Model.ProposedSupervisorStaffNumber"
               class="form-control" />
    </div>

    @* TODO (Lab Part 1 & Part 2): Remove SubmittedDate from the form — set it automatically on the server! *@
    <div class="mb-3">
        <label asp-for="SubmittedDate"
               class="form-label"></label>
        <input type="text"
               id="SubmittedDate"
               name="SubmittedDate"
               value="@Model.SubmittedDate.ToString("yyyy-MM-dd")"
               class="form-control" />
    </div>

    @* TODO (Lab Part 7): Add a second submit button (`name="command" value="draft"`) for "Save and return later" *@
    <button type="submit"
            class="btn btn-primary">
        Create
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>
</form>

@* TODO (Lab Part 6): Add native HTML validation attributes (required, maxlength, type="email", type="date") to form controls (see Snippet 6.A) *@
